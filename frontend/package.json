{
  "name": "gomar-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run"
  },
  "dependencies": {
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.0.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.11.1",
    "jsdom": "30.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.12"
  },
  "overrides": {
    "js-beautify": {
      "editorconfig": "4.0.1",
      "glob": "14.0.2"
    }
  }
}
